# ==============================================================================
# Data Source / Persistence Adapter Selection
# ==============================================================================
# "firestore" -> Uses Cloud Firestore (default for sandbox / Firebase mode)
# "api"       -> Uses self-hosted REST API backend (PostgreSQL/MySQL via Express/Nest/etc.)
VITE_DATA_SOURCE="firestore"
# Required when VITE_DATA_SOURCE="api" (e.g. https://api.midominio.com/api or http://localhost:4000/api)
VITE_API_BASE_URL="http://localhost:4000/api"

# ==============================================================================
# Firebase Client Configuration (Used when VITE_DATA_SOURCE="firestore")
# ==============================================================================
# Copy this file to `.env` for local development or pass as Docker --build-arg
# when deploying to Cloud Run / GitHub Actions / Nginx.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional: Firestore named database ID (leave empty for "(default)")
VITE_FIREBASE_DATABASE_ID=""

# ==============================================================================
# Runtime / Platform Metadata
# ==============================================================================
# APP_URL: Public URL where the app is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# Docker Compose / Backend + MariaDB Configuration (Optional for self-hosted server)
# ==============================================================================
APP_PORT="80"
API_PORT="4000"
API_JWT_SECRET=""
CORS_ORIGIN="*"
MARIADB_PORT="3306"
MARIADB_DATABASE="atelier_boutique"
MARIADB_USER="boutique_app"
MARIADB_PASSWORD=""
MARIADB_ROOT_PASSWORD=""
TZ="America/Mexico_City"

